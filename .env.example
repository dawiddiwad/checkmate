# ==============================================================================
# CHECKMATE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure with your actual values.
# Never commit the .env file to version control!
#
# Only secrets live here. Every runtime setting — model, turn cap, step timeout,
# budgets, snapshot filtering, evidence, logging — is a `checkmate*` option set in
# playwright.config.ts, per project and overridable per test:
#
#   import type { CheckmateOptions } from '@xoxoai/checkmate/playwright'
#
#   export default defineConfig<CheckmateOptions>({
#     use: { checkmateModel: 'gpt-5-mini', checkmateTurnCap: 20 },
#   })
#
# See docs/GUIDE.md#configuration for the full option list.

# ==============================================================================
# PROVIDER SECRETS (Required)
# ==============================================================================

# Your API key (REQUIRED).
# Works with OpenAI, or any OpenAI-compatible provider (Claude, Gemini, Groq, local LLMs).
# Get an OpenAI key at: https://platform.openai.com/api-keys
# Get a free Gemini key at: https://aistudio.google.com/app/api-keys
CHECKMATE_OPENAI_API_KEY=your_api_key_here

# The base URL for an OpenAI-compatible API is not read from the environment — it is the
# `checkmateOpenaiBaseUrl` option in playwright.config.ts, because a config file is checked
# in and a key is not:
#
#   use: { checkmateOpenaiBaseUrl: 'https://generativelanguage.googleapis.com/v1beta/openai/' }
#
# - Anthropic Claude: https://api.anthropic.com/v1
# - Google Gemini:    https://generativelanguage.googleapis.com/v1beta/openai/
# - Azure OpenAI:     https://YOUR_RESOURCE.openai.azure.com
# - Local LLMs:       http://localhost:1234/v1
# Leave unset for the standard OpenAI API.

# ==============================================================================
# EXAMPLES ONLY
# ==============================================================================

# The bundled examples ship provider-agnostic, so their playwright.config.ts reads the
# model name from here. In your own suite this is a literal in the config file instead.
# CHECKMATE_MODEL=gpt-5-mini

# Browser settings (viewport, headless mode, video, timeouts) are configured in
# playwright.config.ts using Playwright's own mechanism.
# See: https://playwright.dev/docs/test-configuration
#
# ==============================================================================
# SALESFORCE (Optional - required for Salesforce examples only)
# ==============================================================================
#
# No environment variables needed. The integration uses the Salesforce CLI (sf) default org:
#   1. npm install -g @salesforce/cli
#   2. sf org login web --alias my-org --set-default
