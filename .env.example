# Runtime secret bindings
# Checkmate does not automatically load .env. Export secrets in the invoking
# environment or load this file explicitly before invoking the CLI or API.
# Never commit a populated .env file.
#
# checkmate.config.json names each environment-backed logical secret binding:
# "secretBindings": {
#   "openai-api-key": { "source": "environment", "name": "CHECKMATE_OPENAI_API_KEY" }
# }
# The selected policy uses provider.apiKeyBinding: "openai-api-key".
# Model, endpoint, limits, driver settings, and evidence policy belong in the
# manifest, not environment variables. See docs/CONFIGURATION.md.
CHECKMATE_OPENAI_API_KEY=

# Repository live acceptance only
# npm run test:e2e:ollama and npm run phase:verify -- --live explicitly load
# the repository-root .env. All three values below must be non-empty when
# selecting live acceptance; missing values fail rather than skip the test.
# The test harness writes a temporary manifest using these values. They are
# not implicit configuration inputs to normal Checkmate CLI or API calls.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
