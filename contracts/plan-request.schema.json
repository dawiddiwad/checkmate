{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"contractVersion": {
			"const": "toolkit-1"
		},
		"requestId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
		},
		"caller": {
			"type": "string",
			"minLength": 1
		},
		"operation": {
			"const": "plan"
		},
		"target": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string",
					"minLength": 1
				},
				"sha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				}
			},
			"required": ["path", "sha256"],
			"additionalProperties": false
		},
		"objective": {
			"type": "string",
			"minLength": 1
		},
		"requirements": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
					},
					"text": {
						"type": "string",
						"minLength": 1
					},
					"source": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": ["id", "text", "source"],
				"additionalProperties": false
			},
			"minItems": 1,
			"uniqueItems": true
		},
		"sourceContext": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"uri": {
						"type": "string",
						"minLength": 1
					},
					"content": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": ["uri", "content"],
				"additionalProperties": false
			},
			"minItems": 0,
			"uniqueItems": true
		},
		"outputPlanId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
		},
		"planDirectory": {
			"type": "string",
			"minLength": 1
		}
	},
	"required": [
		"contractVersion",
		"requestId",
		"caller",
		"operation",
		"target",
		"objective",
		"requirements",
		"sourceContext",
		"outputPlanId",
		"planDirectory"
	],
	"additionalProperties": false
}
