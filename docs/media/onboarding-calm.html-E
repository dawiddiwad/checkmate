<!doctype html>
<html lang="en">
<meta charset="utf-8" />
<title>Checkmate onboarding, calm</title>
<link rel="stylesheet" href="style.css" />
<style>
	@font-face { font-family: 'Space Grotesk'; src: url('fonts/space-grotesk.woff2') format('woff2'); font-weight: 300 700; }
	@font-face { font-family: 'Inter'; src: url('fonts/inter.woff2') format('woff2'); font-weight: 100 900; }
	@font-face { font-family: 'JetBrains Mono'; src: url('fonts/jetbrains-mono.woff2') format('woff2'); font-weight: 100 800; }
	main { width: 900px; height: 420px; position: relative; overflow: hidden; background: var(--bg); }

	.loop { position: absolute; left: 0; top: 16px; width: 900px; height: 300px; }
	.loop svg { position: absolute; left: 0; top: 0; }
	.ring { fill: none; stroke: var(--line-strong); stroke-width: 3; }
	.ring-head { fill: var(--line-strong); }
	.route { fill: none; stroke-width: 5; stroke-linecap: round; }
	.change { fill: none; stroke: var(--amber); stroke-width: 5; stroke-linecap: round; }
	.change.dim { stroke: var(--amber-line); stroke-width: 3; }
	.station { position: absolute; width: 124px; height: 36px; margin: -18px 0 0 -62px; border: 2px solid var(--line-strong); border-radius: 8px; background: var(--card); font: 600 18px/32px var(--display); text-align: center; white-space: nowrap; color: var(--faint); }
	.station .lit { position: absolute; inset: -2px; border-radius: 8px; color: var(--bg); line-height: 36px; }
	.centre { position: absolute; left: 340px; top: 86px; width: 220px; height: 120px; display: flex; align-items: center; justify-content: center; gap: 12px; font: 600 22px var(--display); color: var(--muted); }
	.centre .mark { gap: 3px; }
	.centre .mark i { width: 12px; height: 12px; }
	.sentence { position: absolute; left: 0; top: 332px; width: 900px; text-align: center; font: 500 28px/40px var(--display); }
</style>
<main>
	<div class="loop">
		<svg width="900" height="300">
			<rect class="ring" x="210" y="26" width="480" height="244" rx="24" />
			<path class="ring-head" d="M456 26 l-10 -6 v12 z" />
			<path class="ring-head" d="M690 154 l-6 -10 h12 z" />
			<path class="ring-head" d="M480 270 l10 -6 v12 z" />
			<path class="change dim" d="M268 270 H234 Q210 270 210 246 V50 Q210 26 234 26 H268" />
			<path class="ring-head" style="fill: var(--amber-line)" d="M210 141 l-7 11 h14 z" />
			<path class="route" data-light="top" style="stroke: var(--oracle)" d="M392 26 H508" />
			<path data-light="top" style="fill: var(--oracle)" d="M460 26 l-13 -8 v16 z" />
			<path class="route" data-light="right" style="stroke: var(--factory)" d="M632 26 H666 Q690 26 690 50 V246 Q690 270 666 270 H632" />
			<path data-light="right" style="fill: var(--factory)" d="M690 158 l-8 -13 h16 z" />
			<path class="route" data-light="bottom" style="stroke: var(--qa)" d="M508 270 H392" />
			<path data-light="bottom" style="fill: var(--qa)" d="M476 270 l13 -8 v16 z" />
			<path class="change" data-light="change" d="M268 270 H234 Q210 270 210 246 V50 Q210 26 234 26 H268" />
			<path data-light="change" style="fill: var(--amber)" d="M210 139 l-9 14 h18 z" />
			<line class="spoke" x1="330" y1="44" x2="330" y2="58" />
			<line class="spoke" x1="570" y1="44" x2="570" y2="58" />
			<line class="spoke" x1="570" y1="252" x2="570" y2="234" />
			<line class="spoke" x1="330" y1="252" x2="330" y2="234" />
			<line class="hot" data-light="planner" style="stroke: var(--planner)" x1="330" y1="44" x2="330" y2="58" />
			<line class="hot" data-light="oracle" style="stroke: var(--oracle)" x1="570" y1="44" x2="570" y2="58" />
			<line class="hot" data-light="factory" style="stroke: var(--factory)" x1="570" y1="252" x2="570" y2="234" />
			<line class="hot" data-light="qa" style="stroke: var(--qa)" x1="330" y1="252" x2="330" y2="234" />
		</svg>
		<div class="centre">
			<div class="top"><span class="mark"><i></i><i></i><i></i><i></i></span>checkmate</div>
		</div>
		<div class="station planner" style="left: 330px; top: 26px">Planner<div class="lit" data-light="planner" style="background: var(--planner)">Planner</div></div>
		<div class="station oracle" style="left: 570px; top: 26px">Oracle<div class="lit" data-light="oracle" style="background: var(--oracle)">Oracle</div></div>
		<div class="station factory" style="left: 570px; top: 270px">Factory<div class="lit" data-light="factory" style="background: var(--factory)">Factory</div></div>
		<div class="station qa" style="left: 330px; top: 270px">QA<div class="lit" data-light="qa" style="background: var(--qa)">QA</div></div>
	</div>
	<div class="sentence" id="sentence"></div>
</main>
<script>
	const fade = 0.8
	const beatLength = 5
	const beats = [
	  {
	    "text": "Ticket SHOP-12 comes in. The planner writes a plan.",
	    "lights": [
	      "planner"
	    ]
	  },
	  {
	    "text": "QA tries the first build and notes its questions.",
	    "lights": [
	      "qa"
	    ]
	  },
	  {
	    "text": "The oracle answers the questions.",
	    "lights": [
	      "oracle",
	      "top"
	    ]
	  },
	  {
	    "text": "The answers improve the plan.",
	    "lights": [
	      "planner",
	      "change"
	    ]
	  },
	  {
	    "text": "The factory fixes what QA found.",
	    "lights": [
	      "factory",
	      "right"
	    ]
	  },
	  {
	    "text": "QA tests the new build again.",
	    "lights": [
	      "qa",
	      "bottom"
	    ]
	  },
	  {
	    "text": "No findings left. The oracle accepts the tests.",
	    "lights": [
	      "oracle"
	    ]
	  }
	]
	const ramp = (time, start, length) => Math.min(1, Math.max(0, (time - start) / length))
	const sentence = document.getElementById('sentence')

	// One beat is on screen at a time. It fades in, stays, and fades out.
	const visible = (time, index) => {
		const start = index * beatLength
		return ramp(time, start, fade) * (1 - ramp(time, start + beatLength - fade, fade))
	}

	window.DURATION = beats.length * beatLength
	window.measure = () => {}
	window.renderFrame = (time) => {
		const index = Math.min(beats.length - 1, Math.floor(time / beatLength))
		const level = visible(time, index)
		sentence.textContent = beats[index].text
		sentence.style.opacity = level
		for (const light of document.querySelectorAll('[data-light]'))
			light.style.opacity = beats[index].lights.includes(light.dataset.light) ? level : 0
	}
</script>
</html>
