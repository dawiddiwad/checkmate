{
	"name": "@xoxoai/checkmate",
	"version": "0.5.0",
	"description": "AI‑driven e2e test automation framework built on Playwright Test and OpenAI API",
	"homepage": "https://github.com/dawiddiwad/checkmate",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dawiddiwad/checkmate.git"
	},
	"keywords": [
		"test-automation",
		"e2e-testing",
		"playwright",
		"openai",
		"ai-testing",
		"low-code",
		"salesforce",
		"gemini",
		"claude",
		"groq"
	],
	"files": [
		"bin",
		"dist",
		"schemas",
		"docs/BENCHMARK.md",
		"docs/CLI.md",
		"docs/CONFIGURATION.md",
		"docs/DRIVERS.md",
		"docs/EVIDENCE.md",
		"docs/EXTENSIONS.md",
		"docs/GUIDE.md",
		"docs/ROADMAP.md",
		"playwright.config.ts",
		"README.md",
		"test/examples",
		"templates",
		"LICENSE"
	],
	"bin": {
		"checkmate": "bin/checkmate.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "dist/core.js",
	"types": "dist/core.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/core.d.ts",
			"default": "./dist/core.js"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"default": "./dist/core.js"
		},
		"./playwright": {
			"types": "./dist/playwright.d.ts",
			"default": "./dist/playwright.js"
		},
		"./salesforce": {
			"types": "./dist/salesforce.d.ts",
			"default": "./dist/salesforce.js"
		},
		"./driver": {
			"types": "./dist/driver.d.ts",
			"default": "./dist/driver.js"
		},
		"./driver-web": {
			"types": "./dist/drivers/web/index.d.ts",
			"default": "./dist/drivers/web/index.js"
		},
		"./driver-web/checkmate-driver.json": "./dist/drivers/web/checkmate-driver.json",
		"./schemas/*": "./schemas/*"
	},
	"scripts": {
		"checkmate:install": "npm install && npx playwright install",
		"build": "npm run validation:check && npm run build:package",
		"build:dist": "tsc -p tsconfig.build.json",
		"build:package": "npm run clean && npm run build:dist && node scripts/copy-package-assets.mjs",
		"clean": "rm -rf dist schemas",
		"prepack": "npm run build:package",
		"phase:verify": "node test/package/lifecycle.mjs",
		"test:package:active": "node test/package/active-exports.mjs",
		"test:acceptance:agent": "node test/acceptance/agent-workflow.mjs",
		"test:e2e:ollama": "node test/acceptance/ollama-cli.mjs",
		"validation:check": "npm run compile:check && npm run lint:check && npm run format:check && npm run test:unit:run",
		"compile:check": "npx tsc --noEmit",
		"lint:check": "eslint .",
		"lint:fix": "eslint . --fix",
		"format:check": "prettier . --check",
		"format:fix": "prettier . --write",
		"test:unit": "vitest --config src/test/vitest.config.ts",
		"test:unit:ui": "vitest --ui --config src/test/vitest.config.ts",
		"test:unit:coverage": "vitest --coverage --config src/test/vitest.config.ts",
		"test:unit:run": "vitest run --config src/test/vitest.config.ts",
		"test:web": "npm run build:dist && npx playwright test --project=web",
		"test:salesforce": "npm run build:dist && npx playwright test --project=salesforce",
		"test:web:example": "npm run build:dist && npx playwright test --project=web --grep=ollama",
		"show:report": "npx playwright show-report test-reports/html"
	},
	"author": "Dawid Dobrowolski SoftQA",
	"license": "MIT",
	"dependencies": {
		"@huggingface/transformers": "^4.0.1",
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"openai": "^6.34.0",
		"playwright": "^1.59.1",
		"sharp": "^0.35.2",
		"string-similarity": "^4.0.4",
		"strip-ansi": "^7.2.0",
		"winston": "^3.19.0",
		"yaml": "^2.8.3",
		"zod": "^4.3.6"
	},
	"peerDependencies": {
		"@playwright/test": "^1.59.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@types/node": "^26.0.0",
		"@types/string-similarity": "^4.0.2",
		"@vitest/coverage-v8": "^4.1.4",
		"@vitest/ui": "^4.1.2",
		"dotenv": "^17.4.1",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.8.3",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.2",
		"vitest": "^4.1.2"
	},
	"directories": {
		"doc": "docs",
		"test": "test"
	},
	"bugs": {
		"url": "https://github.com/dawiddiwad/checkmate/issues"
	}
}
