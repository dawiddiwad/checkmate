{
	"name": "@xoxoai/checkmate",
	"version": "0.5.0",
	"description": "Agent-first test automation harness with versioned requests, bounded execution, and durable evidence",
	"homepage": "https://github.com/dawiddiwad/checkmate",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dawiddiwad/checkmate.git"
	},
	"keywords": [
		"test-automation",
		"e2e-testing",
		"ai-testing",
		"agents",
		"test-harness",
		"cli",
		"playwright"
	],
	"files": [
		"bin",
		"dist",
		"schemas",
		"docs/CLI.md",
		"docs/CONFIGURATION.md",
		"docs/DRIVERS.md",
		"docs/EVIDENCE.md",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"checkmate": "bin/checkmate.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./driver": {
			"types": "./dist/driver.d.ts",
			"default": "./dist/driver.js"
		},
		"./driver-web": {
			"types": "./dist/drivers/web/index.d.ts",
			"default": "./dist/drivers/web/index.js"
		},
		"./driver-web/checkmate-driver.json": "./dist/drivers/web/checkmate-driver.json",
		"./schemas/*": "./schemas/*"
	},
	"scripts": {
		"checkmate:install": "npm install && npx playwright install",
		"build": "npm run validation:check && npm run build:package",
		"build:dist": "tsc -p tsconfig.build.json",
		"build:package": "npm run clean && npm run build:dist && node scripts/copy-package-assets.mjs",
		"clean": "rm -rf dist schemas",
		"prepack": "npm run build:package",
		"phase:verify": "node test/package/lifecycle.mjs",
		"test:package:active": "node test/package/active-exports.mjs",
		"test:acceptance:agent": "node test/acceptance/agent-workflow.mjs",
		"test:e2e:ollama": "node test/acceptance/ollama-cli.mjs",
		"validation:check": "npm run compile:check && npm run lint:check && npm run format:check && npm run test:unit:run",
		"compile:check": "npx tsc --noEmit",
		"lint:check": "eslint .",
		"lint:fix": "eslint . --fix",
		"format:check": "prettier . --check",
		"format:fix": "prettier . --write",
		"test:unit": "vitest --config src/test/vitest.config.ts",
		"test:unit:ui": "vitest --ui --config src/test/vitest.config.ts",
		"test:unit:coverage": "vitest --coverage --config src/test/vitest.config.ts",
		"test:unit:run": "vitest run --config src/test/vitest.config.ts",
		"test:package:final": "node test/package/final-surface.mjs"
	},
	"author": "Dawid Dobrowolski SoftQA",
	"license": "MIT",
	"dependencies": {
		"@huggingface/transformers": "^4.2.0",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"openai": "^7.10.0",
		"playwright": "^1.63.0",
		"sharp": "^0.35.4",
		"yaml": "^2.9.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.5.0",
		"@vitest/coverage-v8": "^5.0.0",
		"@vitest/ui": "^5.0.0",
		"dotenv": "^17.4.2",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.6",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.0"
	},
	"directories": {
		"doc": "docs",
		"test": "test"
	},
	"bugs": {
		"url": "https://github.com/dawiddiwad/checkmate/issues"
	}
}
