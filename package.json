{
	"name": "@xoxoai/checkmate",
	"version": "0.7.0",
	"description": "Testing workflows and evidence contracts for Claude Code",
	"type": "module",
	"engines": {
		"node": ">=24.12.0"
	},
	"scripts": {
		"test": "node --test test/*.test.js",
		"test:tools": "node --test test/tools.test.js",
		"test:live": "node test/live.js && node test/live-session.js",
		"type:check": "node scripts/generate-types.ts --check && tsc --noEmit",
		"lint:check": "eslint src bin scripts test",
		"format:check": "prettier . --check",
		"phase:verify": "npm run type:check && npm run lint:check && npm run format:check && npm test && node test/plugin.js"
	},
	"dependencies": {
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1"
	},
	"devDependencies": {
		"@anthropic-ai/claude-code": "2.1.319",
		"@eslint/js": "10.0.1",
		"@playwright/cli": "0.1.23",
		"@types/node": "26.5.0",
		"eslint": "10.10.0",
		"prettier": "3.9.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"playwright-core": "1.65.0-alpha-2026-10-30"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dawiddiwad/checkmate.git"
	},
	"license": "MIT",
	"private": true
}
