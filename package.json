{
	"name": "@xoxoai/checkmate",
	"version": "0.7.2",
	"description": "Testing workflows and evidence contracts for Claude Code",
	"type": "module",
	"engines": {
		"node": ">=24.12.0"
	},
	"scripts": {
		"test": "node --test test/*.test.ts",
		"test:tools": "node --test test/tools.test.ts",
		"test:live": "node test/live.ts && node test/live-session.ts",
		"type:check": "node scripts/generate-types.ts --check && node scripts/generate-validators.ts --check && node scripts/build-plugin.ts --check && tsc --noEmit",
		"lint:check": "eslint plugin cli scripts test",
		"format:check": "prettier . --check",
		"format:fix": "prettier . --write",
		"phase:verify": "npm run type:check && npm run lint:check && npm run format:check && npm test && node test/plugin.ts",
		"generate": "node scripts/generate-types.ts && node scripts/generate-validators.ts",
		"build": "npm run generate && node scripts/build-plugin.ts"
	},
	"devDependencies": {
		"@anthropic-ai/claude-code": "2.1.322",
		"@eslint/js": "10.0.1",
		"@playwright/cli": "0.1.24",
		"@types/node": "26.6.6",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"esbuild": "0.28.2",
		"eslint": "10.14.0",
		"playwright-core": "1.65.0",
		"prettier": "3.10.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dawiddiwad/checkmate.git"
	},
	"license": "MIT",
	"private": true
}
