{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"contractVersion": {
			"const": "toolkit-2"
		},
		"requestId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
		},
		"caller": {
			"type": "string",
			"minLength": 1
		},
		"operation": {
			"const": "execute"
		},
		"runId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
		},
		"plan": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string",
					"minLength": 1
				},
				"sha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				}
			},
			"required": ["path", "sha256"],
			"additionalProperties": false
		},
		"target": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string",
					"minLength": 1
				},
				"sha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				}
			},
			"required": ["path", "sha256"],
			"additionalProperties": false
		},
		"selectedTestIds": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
			},
			"minItems": 1,
			"uniqueItems": true
		},
		"partialExecution": {
			"enum": ["wait_for_resolution", "ready_only"]
		},
		"timeoutSeconds": {
			"type": "integer",
			"minimum": 1,
			"maximum": 3600
		},
		"onNewBlocker": {
			"enum": ["return_to_caller", "continue_independent"]
		},
		"applicationBuild": {
			"type": "string",
			"minLength": 1
		},
		"outputDirectory": {
			"type": "string",
			"minLength": 1
		},
		"retestOf": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string",
					"minLength": 1
				},
				"sha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				}
			},
			"required": ["path", "sha256"],
			"additionalProperties": false
		}
	},
	"required": [
		"contractVersion",
		"requestId",
		"caller",
		"operation",
		"runId",
		"plan",
		"target",
		"selectedTestIds",
		"timeoutSeconds",
		"onNewBlocker",
		"applicationBuild",
		"outputDirectory"
	],
	"additionalProperties": false
}
