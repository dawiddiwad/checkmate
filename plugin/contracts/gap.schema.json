{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "gap.schema.json",
	"type": "object",
	"properties": {
		"id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
		},
		"severity": {
			"enum": ["blocking", "non_blocking"]
		},
		"status": {
			"enum": ["open", "resolved", "deferred"]
		},
		"requirementIds": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
			},
			"minItems": 0,
			"uniqueItems": true
		},
		"testIds": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^([A-Za-z0-9][A-Za-z0-9_-]{0,95}:)?[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
			},
			"minItems": 0,
			"uniqueItems": true
		},
		"question": {
			"type": "string",
			"minLength": 1
		},
		"consequence": {
			"type": "string",
			"minLength": 1
		},
		"decisionId": {
			"anyOf": [
				{
					"type": "string",
					"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
				},
				{
					"type": "null"
				}
			]
		}
	},
	"required": ["id", "severity", "status", "requirementIds", "testIds", "question", "consequence", "decisionId"],
	"additionalProperties": false
}
