{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "instance.schema.json",
	"type": "object",
	"properties": {
		"entries": {
			"type": "object",
			"propertyNames": {
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
			},
			"additionalProperties": {
				"type": "string",
				"minLength": 1
			},
			"minProperties": 1
		},
		"environment": {
			"type": "string",
			"minLength": 1
		},
		"references": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"minItems": 0,
			"uniqueItems": true
		}
	},
	"required": ["entries"],
	"additionalProperties": false
}
