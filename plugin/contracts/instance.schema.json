{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "instance.schema.json",
	"type": "object",
	"properties": {
		"entries": {
			"type": "object",
			"propertyNames": {
				"$ref": "identifier.schema.json"
			},
			"additionalProperties": {
				"type": "string",
				"maxLength": 2000,
				"pattern": "\\S"
			},
			"minProperties": 1
		},
		"environment": {
			"type": "string",
			"maxLength": 500,
			"pattern": "\\S"
		},
		"build": {
			"$ref": "build.schema.json"
		},
		"references": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 200
			},
			"minItems": 0,
			"uniqueItems": true
		}
	},
	"required": ["entries"],
	"additionalProperties": false
}
