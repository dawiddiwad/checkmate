{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "journal-note.schema.json",
	"description": "Anything else, for example where you explored.",
	"type": "object",
	"properties": {
		"kind": {
			"const": "note"
		},
		"id": {
			"$ref": "journal-entry.schema.json#/definitions/id"
		},
		"build": {
			"$ref": "journal-entry.schema.json#/definitions/build"
		},
		"supersedes": {
			"$ref": "journal-entry.schema.json#/definitions/supersedes"
		},
		"text": {
			"description": "The note.",
			"type": "string",
			"minLength": 1
		},
		"about": {
			"$ref": "journal-entry.schema.json#/definitions/about"
		},
		"area": {
			"$ref": "journal-entry.schema.json#/definitions/area"
		},
		"to": {
			"description": "The short name of the actor that must read the note, for example a2. team: all testers.",
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
		},
		"assign": {
			"description": "The short name of the tester that must cover the area, for example a1. Give it with area. The text tells the tester what to cover.",
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
		}
	},
	"required": ["kind", "text"],
	"dependencies": {
		"assign": ["area"]
	},
	"additionalProperties": false,
	"examples": [
		{
			"kind": "note",
			"assign": "a1",
			"area": "src/cart.js",
			"text": "Test the discount rules, and the totals, lists, and exports that show the cart."
		}
	]
}
