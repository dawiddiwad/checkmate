{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "journal-question.schema.json",
	"description": "A question for the product owner. Ask one question in each entry. Ask about each rule, limit, and case that the sources leave open.",
	"type": "object",
	"properties": {
		"kind": {
			"const": "question"
		},
		"id": {
			"$ref": "journal-entry.schema.json#/definitions/id"
		},
		"supersedes": {
			"$ref": "journal-entry.schema.json#/definitions/supersedes"
		},
		"rule": {
			"$ref": "journal-entry.schema.json#/definitions/rule"
		},
		"question": {
			"description": "The question.",
			"type": "string",
			"minLength": 1
		},
		"actual": {
			"description": "What the build does now, in one sentence.",
			"type": "string",
			"minLength": 1
		},
		"about": {
			"$ref": "journal-entry.schema.json#/definitions/about"
		},
		"blocking": {
			"description": "true only when you could not test a part of the change without the answer.",
			"type": "boolean"
		}
	},
	"required": ["kind", "question"],
	"additionalProperties": false
}
