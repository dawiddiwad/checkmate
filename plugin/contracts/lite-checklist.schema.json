{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "lite-checklist.schema.json",
	"type": "object",
	"properties": {
		"objective": {
			"type": "string",
			"minLength": 1
		},
		"items": {
			"type": "array",
			"items": {
				"$ref": "plan.schema.json#/properties/requirements/items"
			},
			"minItems": 1
		},
		"questions": {
			"type": "array",
			"items": {
				"$ref": "lite-record.schema.json#/definitions/question"
			}
		}
	},
	"required": ["objective", "items"],
	"additionalProperties": false
}
