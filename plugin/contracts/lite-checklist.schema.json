{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "lite-checklist.schema.json",
	"type": "object",
	"properties": {
		"objective": {
			"type": "string",
			"minLength": 1
		},
		"criteria": {
			"type": "integer",
			"minimum": 0
		},
		"items": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/item"
			},
			"minItems": 1
		},
		"questions": {
			"type": "array",
			"items": {
				"$ref": "lite-record.schema.json#/definitions/question"
			}
		}
	},
	"required": ["objective", "criteria", "items"],
	"additionalProperties": false,
	"definitions": {
		"value": {
			"type": "string",
			"minLength": 1,
			"maxLength": 500
		},
		"item": {
			"type": "object",
			"properties": {
				"id": {
					"$ref": "lite-record.schema.json#/definitions/identifier"
				},
				"text": {
					"$ref": "lite-record.schema.json#/definitions/text"
				},
				"source": {
					"$ref": "lite-record.schema.json#/definitions/text"
				},
				"criterion": {
					"type": "integer",
					"minimum": 1
				},
				"baseline": {
					"type": "object",
					"properties": {
						"steps": {
							"$ref": "#/definitions/value"
						},
						"value": {
							"$ref": "#/definitions/value"
						},
						"documented": {
							"$ref": "#/definitions/value"
						}
					},
					"required": ["steps", "value", "documented"],
					"additionalProperties": false
				}
			},
			"required": ["id", "text", "source"],
			"additionalProperties": false
		}
	}
}
