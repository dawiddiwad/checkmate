{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"contractVersion": {
			"const": "toolkit-2"
		},
		"requestId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
		},
		"runId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
		},
		"completion": {
			"enum": ["completed", "interrupted", "operational_error"]
		},
		"plan": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string",
					"minLength": 1
				},
				"sha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				}
			},
			"required": ["path", "sha256"],
			"additionalProperties": false
		},
		"target": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string",
					"minLength": 1
				},
				"sha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				}
			},
			"required": ["path", "sha256"],
			"additionalProperties": false
		},
		"applicationBuild": {
			"type": "string",
			"minLength": 1
		},
		"host": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"version": {
					"anyOf": [
						{
							"type": "string",
							"minLength": 1
						},
						{
							"type": "null"
						}
					]
				},
				"model": {
					"anyOf": [
						{
							"type": "string",
							"minLength": 1
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["name", "version", "model"],
			"additionalProperties": false
		},
		"selectedTestIds": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
			},
			"minItems": 1,
			"uniqueItems": true
		},
		"startedAt": {
			"type": "string",
			"format": "date-time"
		},
		"tests": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"testId": {
						"type": "string",
						"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
					},
					"outcome": {
						"enum": ["passed", "failed", "blocked", "not_run", "error"]
					},
					"expected": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					},
					"observed": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					},
					"assertionKind": {
						"anyOf": [
							{
								"enum": ["deterministic", "agent_observation"]
							},
							{
								"type": "null"
							}
						]
					},
					"evidenceIds": {
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
						},
						"minItems": 0,
						"uniqueItems": true
					},
					"reason": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					}
				},
				"required": ["testId", "outcome", "expected", "observed", "assertionKind", "evidenceIds", "reason"],
				"additionalProperties": false
			},
			"minItems": 1,
			"uniqueItems": true
		},
		"findings": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
					},
					"type": {
						"enum": ["defect", "potential_issue"]
					},
					"severity": {
						"enum": ["low", "medium", "high", "critical"]
					},
					"testIds": {
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
						},
						"minItems": 1,
						"uniqueItems": true
					},
					"requirementIds": {
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
						},
						"minItems": 1,
						"uniqueItems": true
					},
					"title": {
						"type": "string",
						"minLength": 1
					},
					"expected": {
						"type": "string",
						"minLength": 1
					},
					"observed": {
						"type": "string",
						"minLength": 1
					},
					"reproduction": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						},
						"minItems": 1,
						"uniqueItems": true
					},
					"evidenceIds": {
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
						},
						"minItems": 1,
						"uniqueItems": true
					}
				},
				"required": [
					"id",
					"type",
					"severity",
					"testIds",
					"requirementIds",
					"title",
					"expected",
					"observed",
					"reproduction",
					"evidenceIds"
				],
				"additionalProperties": false
			},
			"minItems": 0,
			"uniqueItems": true
		},
		"newGaps": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
					},
					"severity": {
						"enum": ["blocking", "non_blocking"]
					},
					"status": {
						"enum": ["open", "resolved", "deferred"]
					},
					"requirementIds": {
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
						},
						"minItems": 0,
						"uniqueItems": true
					},
					"testIds": {
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
						},
						"minItems": 0,
						"uniqueItems": true
					},
					"question": {
						"type": "string",
						"minLength": 1
					},
					"consequence": {
						"type": "string",
						"minLength": 1
					},
					"decisionId": {
						"anyOf": [
							{
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
							},
							{
								"type": "null"
							}
						]
					}
				},
				"required": ["id", "severity", "status", "requirementIds", "testIds", "question", "consequence", "decisionId"],
				"additionalProperties": false
			},
			"minItems": 0,
			"uniqueItems": true
		},
		"evidence": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
					},
					"kind": {
						"enum": ["observation", "http_exchange", "screenshot", "trace"]
					},
					"path": {
						"type": "string",
						"minLength": 1,
						"description": "Relative to the output directory. For example: evidence/T1.txt."
					}
				},
				"required": ["id", "kind", "path"],
				"additionalProperties": false
			},
			"minItems": 0,
			"uniqueItems": true
		},
		"cleanup": {
			"type": "object",
			"properties": {
				"status": {
					"enum": ["completed", "failed", "not_applicable"]
				},
				"reason": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": ["status", "reason"],
			"additionalProperties": false
		},
		"retestOf": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string",
					"minLength": 1
				},
				"sha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				}
			},
			"required": ["path", "sha256"],
			"additionalProperties": false
		}
	},
	"required": [
		"contractVersion",
		"requestId",
		"runId",
		"completion",
		"plan",
		"target",
		"applicationBuild",
		"host",
		"selectedTestIds",
		"startedAt",
		"tests",
		"findings",
		"newGaps",
		"evidence",
		"cleanup"
	],
	"additionalProperties": false
}
