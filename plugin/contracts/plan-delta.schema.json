{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "plan-delta.schema.json",
	"type": "object",
	"properties": {
		"requirements": {
			"type": "object",
			"propertyNames": {
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"remove": {
						"type": "boolean"
					},
					"text": {
						"type": "string",
						"minLength": 1
					},
					"source": {
						"type": "string",
						"minLength": 1
					},
					"area": {
						"type": "string",
						"minLength": 1,
						"maxLength": 40
					}
				},
				"additionalProperties": false,
				"minProperties": 1
			}
		},
		"tests": {
			"type": "object",
			"propertyNames": {
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"remove": {
						"type": "boolean"
					},
					"title": {
						"type": "string",
						"minLength": 1
					},
					"requirementIds": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"capability": {
						"type": "string",
						"minLength": 1
					},
					"operations": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"dependsOn": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"preconditions": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"action": {
						"type": "string",
						"minLength": 1
					},
					"assertions": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"check": {
									"type": "string",
									"minLength": 1
								},
								"checkKind": {
									"type": "string",
									"enum": ["deterministic", "agent_observation"]
								},
								"observe": {
									"type": "string",
									"minLength": 1
								},
								"expected": {
									"type": "string",
									"minLength": 1
								}
							},
							"required": ["check", "checkKind"],
							"additionalProperties": false
						}
					}
				},
				"additionalProperties": false,
				"minProperties": 1
			}
		}
	},
	"required": ["tests"],
	"additionalProperties": false
}
