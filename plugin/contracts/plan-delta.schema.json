{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "plan-delta.schema.json",
	"type": "object",
	"properties": {
		"requirements": {
			"type": "object",
			"propertyNames": {
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"remove": {
						"type": "boolean"
					},
					"text": {
						"type": "string",
						"minLength": 1
					},
					"source": {
						"type": "string",
						"minLength": 1
					},
					"area": {
						"type": "string",
						"minLength": 1,
						"maxLength": 40
					}
				},
				"additionalProperties": false,
				"minProperties": 1
			}
		},
		"tests": {
			"type": "object",
			"propertyNames": {
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"remove": {
						"type": "boolean"
					},
					"title": {
						"type": "string",
						"minLength": 1
					},
					"requirementIds": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"capability": {
						"type": "string",
						"minLength": 1
					},
					"operations": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"dependsOn": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"preconditions": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"action": {
						"type": "string",
						"minLength": 1
					},
					"assertions": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"check": {
									"type": "string",
									"minLength": 1
								},
								"checkKind": {
									"type": "string",
									"enum": ["deterministic", "agent_observation"]
								},
								"observe": {
									"type": "string",
									"minLength": 1
								},
								"expected": {
									"type": "string",
									"minLength": 1
								},
								"request": {
									"type": "string",
									"pattern": "^(GET|POST|PUT|PATCH|DELETE) /"
								},
								"observeFrom": {
									"enum": ["screen", "relaunch", "api", "page", "reload"]
								}
							},
							"required": ["check", "checkKind"],
							"additionalProperties": false
						}
					}
				},
				"additionalProperties": false,
				"minProperties": 1
			}
		},
		"gaps": {
			"type": "object",
			"description": "Blocking gaps the revision raises for checks that need a decision before they can be migrated.",
			"propertyNames": {
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"question": {
						"type": "string",
						"minLength": 1
					},
					"consequence": {
						"type": "string",
						"minLength": 1
					},
					"testIds": {
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
						},
						"minItems": 1,
						"uniqueItems": true
					}
				},
				"required": ["question", "consequence", "testIds"],
				"additionalProperties": false
			}
		}
	},
	"required": ["tests"],
	"additionalProperties": false,
	"examples": [
		{
			"tests": {
				"T1": {
					"title": "Read the order total",
					"requirementIds": ["R1"],
					"capability": "browser",
					"operations": ["read_orders"],
					"dependsOn": [],
					"preconditions": [],
					"action": "Open the order confirmation.",
					"assertions": [
						{
							"check": "The order total is 240 PLN.",
							"checkKind": "deterministic",
							"observe": "Order total",
							"expected": "240 PLN"
						}
					]
				}
			}
		}
	]
}
