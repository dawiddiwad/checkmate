{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "plan.schema.json",
	"type": "object",
	"properties": {
		"contractVersion": {
			"const": "toolkit-2"
		},
		"planId": {
			"$ref": "identifier.schema.json"
		},
		"revision": {
			"type": "integer",
			"minimum": 1
		},
		"previousRevision": {
			"anyOf": [
				{
					"type": "integer",
					"minimum": 1
				},
				{
					"type": "null"
				}
			]
		},
		"target": {
			"type": "object",
			"properties": {
				"targetId": {
					"$ref": "identifier.schema.json"
				},
				"revision": {
					"type": "integer",
					"minimum": 1
				},
				"sha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				}
			},
			"required": ["targetId", "revision", "sha256"],
			"additionalProperties": false
		},
		"objective": {
			"type": "string",
			"minLength": 1
		},
		"requirements": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"$ref": "identifier.schema.json"
					},
					"text": {
						"type": "string",
						"minLength": 1
					},
					"source": {
						"type": "string",
						"minLength": 1
					},
					"area": {
						"type": "string",
						"minLength": 1,
						"pattern": "\\S",
						"maxLength": 40
					},
					"metadata": {
						"$ref": "#/definitions/metadata"
					}
				},
				"required": ["id", "text", "source"],
				"additionalProperties": false
			},
			"minItems": 1,
			"uniqueItems": true
		},
		"tests": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/test"
			},
			"minItems": 0,
			"uniqueItems": true
		},
		"gaps": {
			"type": "array",
			"items": {
				"$ref": "gap.schema.json"
			},
			"minItems": 0,
			"uniqueItems": true
		},
		"assumptions": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"decisionId": {
						"$ref": "identifier.schema.json"
					},
					"text": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": ["decisionId", "text"],
				"additionalProperties": false
			},
			"minItems": 0,
			"uniqueItems": true
		},
		"decisions": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"$ref": "identifier.schema.json"
					},
					"gapId": {
						"$ref": "identifier.schema.json"
					},
					"kind": {
						"enum": ["clarify", "accept_assumption", "defer"]
					},
					"actor": {
						"type": "string",
						"minLength": 1
					},
					"rationale": {
						"type": "string",
						"minLength": 1
					},
					"value": {
						"type": "string",
						"minLength": 1
					},
					"source": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					}
				},
				"required": ["id", "gapId", "kind", "actor", "rationale", "value", "source"],
				"additionalProperties": false
			},
			"minItems": 0,
			"uniqueItems": true
		},
		"removals": {
			"description": "Each removal of tests: who removed which tests, why, in which revision, and the gaps that it closed. Earlier revisions keep the removed tests.",
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"revision": {
						"type": "integer",
						"minimum": 1
					},
					"actor": {
						"type": "string",
						"minLength": 1
					},
					"rationale": {
						"type": "string",
						"minLength": 1
					},
					"testIds": {
						"type": "array",
						"items": {
							"$ref": "identifier.schema.json"
						},
						"minItems": 1
					},
					"closedGaps": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"gapId": {
									"$ref": "identifier.schema.json"
								},
								"reason": {
									"type": "string",
									"minLength": 1
								}
							},
							"required": ["gapId", "reason"],
							"additionalProperties": false
						}
					}
				},
				"required": ["revision", "actor", "rationale", "testIds", "closedGaps"],
				"additionalProperties": false
			}
		},
		"coverage": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"requirementId": {
						"$ref": "identifier.schema.json"
					},
					"testIds": {
						"type": "array",
						"items": {
							"$ref": "identifier.schema.json"
						},
						"minItems": 0,
						"uniqueItems": true
					},
					"status": {
						"enum": ["planned", "blocked", "deferred"]
					}
				},
				"required": ["requirementId", "testIds", "status"],
				"additionalProperties": false
			},
			"minItems": 1,
			"uniqueItems": true
		}
	},
	"required": [
		"contractVersion",
		"planId",
		"revision",
		"previousRevision",
		"target",
		"objective",
		"requirements",
		"tests",
		"gaps",
		"assumptions",
		"decisions",
		"coverage"
	],
	"additionalProperties": false,
	"definitions": {
		"test": {
			"type": "object",
			"properties": {
				"id": {
					"$ref": "identifier.schema.json"
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 200
				},
				"requirementIds": {
					"type": "array",
					"items": {
						"$ref": "identifier.schema.json"
					},
					"minItems": 1,
					"uniqueItems": true
				},
				"capability": {
					"$ref": "identifier.schema.json"
				},
				"operations": {
					"type": "array",
					"items": {
						"$ref": "identifier.schema.json"
					},
					"minItems": 1,
					"uniqueItems": true
				},
				"readiness": {
					"enum": ["ready", "blocked", "deferred"]
				},
				"gapIds": {
					"type": "array",
					"items": {
						"$ref": "identifier.schema.json"
					},
					"minItems": 0,
					"uniqueItems": true
				},
				"dependsOn": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^([A-Za-z0-9][A-Za-z0-9_-]{0,95}:)?[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
					},
					"minItems": 0,
					"uniqueItems": true
				},
				"preconditions": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"minItems": 0,
					"uniqueItems": true
				},
				"action": {
					"type": "string",
					"minLength": 1
				},
				"assertions": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/assertion"
					},
					"minItems": 0,
					"uniqueItems": true
				},
				"metadata": {
					"$ref": "#/definitions/metadata"
				}
			},
			"required": [
				"id",
				"title",
				"requirementIds",
				"capability",
				"operations",
				"readiness",
				"gapIds",
				"dependsOn",
				"preconditions",
				"action",
				"assertions"
			],
			"additionalProperties": false
		},
		"assertion": {
			"type": "object",
			"properties": {
				"id": {
					"$ref": "identifier.schema.json"
				},
				"check": {
					"type": "string",
					"minLength": 1
				},
				"checkKind": {
					"enum": ["deterministic", "agent_observation"]
				},
				"observe": {
					"type": "string",
					"minLength": 1
				},
				"expected": {
					"type": "string",
					"minLength": 1
				},
				"request": {
					"type": "string",
					"pattern": "^(GET|POST|PUT|PATCH|DELETE) /"
				},
				"observeFrom": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9_]{0,39}$"
				}
			},
			"required": ["id", "check", "checkKind"],
			"additionalProperties": false
		},
		"metadata": {
			"type": "object",
			"propertyNames": {
				"pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
			},
			"additionalProperties": {
				"type": ["string", "number", "boolean"],
				"maxLength": 500
			},
			"maxProperties": 20
		}
	}
}
