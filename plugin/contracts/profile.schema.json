{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "profile.schema.json",
	"type": "object",
	"properties": {
		"contractVersion": {
			"const": "toolkit-2"
		},
		"targetId": {
			"$ref": "identifier.schema.json"
		},
		"revision": {
			"type": "integer",
			"minimum": 1
		},
		"entryPoints": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"$ref": "identifier.schema.json"
					},
					"kind": {
						"enum": ["url", "command", "value"]
					},
					"purpose": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": ["name", "kind", "purpose"],
				"additionalProperties": false
			},
			"minItems": 1,
			"uniqueItems": true
		},
		"capabilities": {
			"type": "array",
			"items": {
				"$ref": "identifier.schema.json"
			},
			"minItems": 1,
			"uniqueItems": true
		},
		"tools": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					},
					"kind": {
						"enum": ["cli", "mcp", "skill"]
					},
					"purpose": {
						"type": "string",
						"minLength": 1
					},
					"version": {
						"type": "string",
						"minLength": 1
					},
					"executable": {
						"type": "string",
						"minLength": 1
					},
					"reachable": {
						"type": "boolean"
					}
				},
				"required": ["name", "kind", "purpose", "reachable"],
				"additionalProperties": false
			},
			"minItems": 0,
			"uniqueItems": true
		},
		"authentication": {
			"type": "object",
			"properties": {
				"kind": {
					"enum": ["none", "environment", "browser_session"]
				},
				"references": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"minItems": 0,
					"uniqueItems": true
				}
			},
			"required": ["kind", "references"],
			"additionalProperties": false
		},
		"allowedOperations": {
			"type": "array",
			"items": {
				"$ref": "identifier.schema.json"
			},
			"minItems": 1,
			"uniqueItems": true
		},
		"startup": {
			"type": "object",
			"properties": {
				"owner": {
					"enum": ["factory", "checkmate"]
				},
				"command": {
					"anyOf": [
						{
							"type": "array",
							"items": {
								"type": "string",
								"minLength": 1
							},
							"minItems": 1,
							"uniqueItems": true
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["owner", "command"],
			"additionalProperties": false
		},
		"cleanup": {
			"type": "string",
			"minLength": 1
		},
		"reset": {
			"type": "object",
			"properties": {
				"owner": {
					"enum": ["checkmate", "environment", "isolation"]
				},
				"command": {
					"anyOf": [
						{
							"type": "array",
							"items": {
								"type": "string",
								"minLength": 1
							},
							"minItems": 1
						},
						{
							"type": "null"
						}
					]
				},
				"cleanup": {
					"anyOf": [
						{
							"type": "array",
							"items": {
								"type": "string",
								"minLength": 1
							},
							"minItems": 1
						},
						{
							"type": "null"
						}
					]
				},
				"policy": {
					"anyOf": [
						{
							"type": "object",
							"properties": {
								"text": {
									"type": "string",
									"minLength": 1
								}
							},
							"required": ["text"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"path": {
									"type": "string",
									"minLength": 1
								}
							},
							"required": ["path"],
							"additionalProperties": false
						},
						{
							"type": "null"
						}
					]
				},
				"timeoutSeconds": {
					"type": "integer",
					"minimum": 1,
					"maximum": 3600
				},
				"perTest": {
					"type": "boolean"
				}
			},
			"required": ["owner", "command"],
			"additionalProperties": false
		},
		"readyForLiveExecution": {
			"type": "boolean"
		},
		"explore": {
			"type": "object",
			"properties": {
				"level": {
					"$ref": "test-level.schema.json"
				},
				"explorers": {
					"type": "integer",
					"minimum": 1,
					"maximum": 10
				}
			},
			"additionalProperties": false
		},
		"approvals": {
			"type": "object",
			"properties": {
				"plan": {
					"enum": ["required", "none"]
				},
				"result": {
					"enum": ["required", "none"]
				}
			},
			"required": ["plan", "result"],
			"additionalProperties": false
		}
	},
	"required": [
		"contractVersion",
		"targetId",
		"revision",
		"entryPoints",
		"capabilities",
		"tools",
		"authentication",
		"allowedOperations",
		"startup",
		"cleanup",
		"readyForLiveExecution"
	],
	"additionalProperties": false
}
