{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"contractVersion": {
			"const": "toolkit-2"
		},
		"requestId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
		},
		"caller": {
			"type": "string",
			"minLength": 1
		},
		"operation": {
			"const": "report"
		},
		"result": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string",
					"minLength": 1
				},
				"sha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				}
			},
			"required": ["path", "sha256"],
			"additionalProperties": false
		}
	},
	"required": ["contractVersion", "requestId", "caller", "operation", "result"],
	"additionalProperties": false
}
