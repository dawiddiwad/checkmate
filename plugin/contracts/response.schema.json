{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "response.schema.json",
	"type": "object",
	"properties": {
		"status": {
			"enum": ["completed", "needs_decision", "interrupted", "operational_error", "rejected"]
		},
		"subject": {
			"type": "string",
			"minLength": 1
		},
		"reasons": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"minItems": 0,
			"uniqueItems": true
		}
	},
	"required": ["status", "subject", "reasons"],
	"additionalProperties": false
}
