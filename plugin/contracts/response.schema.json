{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"contractVersion": {
			"const": "toolkit-2"
		},
		"requestId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
		},
		"operation": {
			"enum": ["setup", "plan", "revise", "execute", "report"]
		},
		"status": {
			"enum": ["completed", "needs_decision", "invalid_request", "interrupted", "operational_error"]
		},
		"artifact": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"path": {
							"type": "string",
							"minLength": 1
						},
						"sha256": {
							"type": "string",
							"pattern": "^[a-f0-9]{64}$"
						}
					},
					"required": ["path", "sha256"],
					"additionalProperties": false
				},
				{
					"type": "null"
				}
			]
		},
		"reasons": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"minItems": 0,
			"uniqueItems": true
		}
	},
	"required": ["contractVersion", "requestId", "operation", "status", "artifact", "reasons"],
	"additionalProperties": false
}
