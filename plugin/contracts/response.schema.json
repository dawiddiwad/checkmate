{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"contractVersion": {
			"const": "toolkit-2"
		},
		"requestId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
		},
		"operation": {
			"enum": ["setup", "plan", "revise", "execute", "report"]
		},
		"status": {
			"enum": ["completed", "needs_decision", "invalid_request", "interrupted", "operational_error"]
		},
		"artifact": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"path": {
							"type": "string",
							"minLength": 1
						},
						"sha256": {
							"type": "string",
							"pattern": "^[a-f0-9]{64}$"
						}
					},
					"required": ["path", "sha256"],
					"additionalProperties": false
				},
				{
					"type": "null"
				}
			]
		},
		"reasons": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"minItems": 0,
			"uniqueItems": true
		},
		"usage": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"inputTokens": {
							"type": "integer",
							"minimum": 0
						},
						"cacheReadTokens": {
							"type": "integer",
							"minimum": 0
						},
						"cacheWriteTokens": {
							"type": "integer",
							"minimum": 0
						},
						"outputTokens": {
							"type": "integer",
							"minimum": 0
						},
						"peakContextTokens": {
							"anyOf": [
								{
									"type": "integer",
									"minimum": 0
								},
								{
									"type": "null"
								}
							]
						},
						"contextWindowTokens": {
							"anyOf": [
								{
									"type": "integer",
									"minimum": 0
								},
								{
									"type": "null"
								}
							]
						},
						"costUSD": {
							"anyOf": [
								{
									"type": "number",
									"minimum": 0
								},
								{
									"type": "null"
								}
							]
						},
						"costSource": {
							"anyOf": [
								{
									"type": "string",
									"minLength": 1
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": [
						"inputTokens",
						"cacheReadTokens",
						"cacheWriteTokens",
						"outputTokens",
						"peakContextTokens",
						"contextWindowTokens",
						"costUSD",
						"costSource"
					],
					"additionalProperties": false
				},
				{
					"type": "null"
				}
			]
		}
	},
	"required": ["contractVersion", "requestId", "operation", "status", "artifact", "reasons"],
	"additionalProperties": false
}
