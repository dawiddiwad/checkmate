{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"contractVersion": {
			"const": "toolkit-2"
		},
		"requestId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
		},
		"caller": {
			"type": "string",
			"minLength": 1
		},
		"operation": {
			"const": "revise"
		},
		"basePlan": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string",
					"minLength": 1
				},
				"sha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				}
			},
			"required": ["path", "sha256"],
			"additionalProperties": false
		},
		"baseRevision": {
			"type": "integer",
			"minimum": 1
		},
		"decisions": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
					},
					"gapId": {
						"type": "string",
						"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
					},
					"kind": {
						"enum": ["clarify", "accept_assumption", "defer"]
					},
					"actor": {
						"type": "string",
						"minLength": 1
					},
					"rationale": {
						"type": "string",
						"minLength": 1
					},
					"value": {
						"type": "string",
						"minLength": 1
					},
					"source": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					}
				},
				"required": ["id", "gapId", "kind", "actor", "rationale", "value", "source"],
				"additionalProperties": false
			},
			"minItems": 1,
			"uniqueItems": true
		}
	},
	"required": ["contractVersion", "requestId", "caller", "operation", "basePlan", "baseRevision", "decisions"],
	"additionalProperties": false
}
