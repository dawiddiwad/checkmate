{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"contractVersion": {
			"const": "toolkit-2"
		},
		"requestId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
		},
		"caller": {
			"type": "string",
			"minLength": 1
		},
		"operation": {
			"const": "setup"
		},
		"profilePath": {
			"type": "string",
			"minLength": 1
		},
		"targetId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
		},
		"baseUrl": {
			"type": "string",
			"format": "uri"
		},
		"capabilities": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
			},
			"minItems": 1,
			"uniqueItems": true
		},
		"allowedOperations": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
			},
			"minItems": 1,
			"uniqueItems": true
		}
	},
	"required": [
		"contractVersion",
		"requestId",
		"caller",
		"operation",
		"profilePath",
		"targetId",
		"baseUrl",
		"capabilities",
		"allowedOperations"
	],
	"additionalProperties": false
}
