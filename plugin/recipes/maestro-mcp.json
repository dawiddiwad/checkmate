{
	"name": "maestro-mcp",
	"capability": "mobile",
	"kind": "mcp",
	"purpose": "Drive the mobile app on a device through the Maestro MCP server.",
	"detect": "path",
	"entryPoints": [
		{
			"name": "app",
			"kind": "value",
			"purpose": "The app ID of the app under test, for example com.example.shop."
		},
		{
			"name": "device",
			"kind": "value",
			"purpose": "The ID of the simulator or emulator that runs the app."
		}
	],
	"server": {
		"command": "maestro",
		"args": ["mcp", "--no-viewer"],
		"cwd": "{workFolder}"
	},
	"tools": ["inspect_screen", "run", "take_screenshot"],
	"refusedArguments": {
		"run": ["files", "dir"]
	},
	"entryArguments": {
		"device_id": "device"
	},
	"environment": {
		"MAESTRO_CLI_NO_ANALYTICS": "true",
		"MAESTRO_DISABLE_UPDATE_CHECK": "true",
		"XDG_STATE_HOME": "{workFolder}/maestro-state"
	},
	"workspaceFolders": [],
	"observeFrom": {
		"screen": "view",
		"relaunch": "state"
	},
	"evidence": ["screenshot", "view_hierarchy", "recording"],
	"evidenceExtensions": {
		".png": "screenshot",
		".mp4": "recording"
	}
}
