{
	"name": "playwright-cli",
	"capability": "browser",
	"kind": "cli",
	"purpose": "Drive the browser.",
	"detect": "path",
	"entryPoints": [
		{
			"name": "web",
			"kind": "url",
			"purpose": "The application.",
			"pattern": "^https?://"
		}
	],
	"reachable": [
		{
			"check": "http",
			"entry": "web"
		}
	],
	"environment": {
		"PLAYWRIGHT_MCP_OUTPUT_DIR": "{workFolder}",
		"PLAYWRIGHT_CLI_SESSION": "{session}"
	},
	"closeSession": ["-s={session}", "close"],
	"workspaceFolders": [".playwright-cli"],
	"observeFrom": {
		"page": "view",
		"reload": "state"
	},
	"evidence": ["screenshot", "trace"],
	"evidenceExtensions": {
		".png": "screenshot",
		".jpg": "screenshot",
		".jpeg": "screenshot",
		".webp": "screenshot",
		".zip": "trace",
		".trace": "trace"
	}
}
