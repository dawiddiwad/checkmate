{
	"name": "playwright-cli",
	"capability": "browser",
	"kind": "cli",
	"purpose": "Drive the browser.",
	"detect": "path",
	"environment": {
		"PLAYWRIGHT_MCP_OUTPUT_DIR": "{workFolder}",
		"PLAYWRIGHT_CLI_SESSION": "{session}"
	},
	"shellInstruction": "Start each shell command with export PLAYWRIGHT_CLI_SESSION={session}; so that your browser is your own.",
	"workspaceFolders": [".playwright-cli"],
	"observeFrom": {
		"page": "view",
		"reload": "state"
	},
	"evidence": ["screenshot", "trace"],
	"evidenceExtensions": {
		".png": "screenshot",
		".jpg": "screenshot",
		".jpeg": "screenshot",
		".webp": "screenshot",
		".zip": "trace",
		".trace": "trace"
	},
	"usage": "playwright-cli.md"
}
