{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://checkmate.dev/schemas/checkmate-config.v1.json",
	"title": "Checkmate configuration version 1",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "defaultPolicy", "secretBindings", "policies", "drivers"],
	"properties": {
		"schemaVersion": { "const": 1 },
		"outputDirectory": { "type": "string", "minLength": 1 },
		"defaultPolicy": { "$ref": "#/$defs/id" },
		"secretBindings": {
			"type": "object",
			"propertyNames": { "$ref": "#/$defs/id" },
			"additionalProperties": { "$ref": "#/$defs/secretBinding" }
		},
		"policies": {
			"type": "object",
			"minProperties": 1,
			"propertyNames": { "$ref": "#/$defs/id" },
			"additionalProperties": { "$ref": "#/$defs/policy" }
		},
		"drivers": {
			"type": "object",
			"minProperties": 1,
			"propertyNames": { "$ref": "#/$defs/id" },
			"additionalProperties": { "$ref": "#/$defs/driverRegistration" }
		}
	},
	"$defs": {
		"id": { "type": "string", "minLength": 1 },
		"secretBinding": {
			"type": "object",
			"additionalProperties": false,
			"required": ["source", "name"],
			"properties": {
				"source": { "const": "environment" },
				"name": { "type": "string", "minLength": 1 }
			}
		},
		"provider": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "model", "apiKeyBinding"],
			"properties": {
				"id": { "const": "openai" },
				"model": { "type": "string", "minLength": 1 },
				"baseUrl": { "type": "string", "format": "uri" },
				"apiKeyBinding": { "$ref": "#/$defs/id" },
				"temperature": { "type": "number", "minimum": 0 },
				"reasoningEffort": { "enum": ["low", "medium", "high"] }
			}
		},
		"modelEgress": {
			"type": "object",
			"additionalProperties": false,
			"required": ["provider", "textRedaction", "allowOpaque", "maxStepBytes", "maxMessageBytes"],
			"properties": {
				"provider": { "$ref": "#/$defs/provider" },
				"textRedaction": { "enum": ["on", "off"] },
				"allowOpaque": { "type": "boolean" },
				"maxStepBytes": { "type": "integer", "minimum": 1 },
				"maxMessageBytes": { "type": "integer", "minimum": 1 }
			}
		},
		"bounds": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"scenarioTimeoutMs",
				"stepTimeoutMs",
				"turnsPerStep",
				"requestTimeoutMs",
				"maxRetries",
				"loopMaxRepetitions",
				"cleanupTimeoutMs"
			],
			"properties": {
				"scenarioTimeoutMs": { "type": "integer", "minimum": 1 },
				"stepTimeoutMs": { "type": "integer", "minimum": 1 },
				"turnsPerStep": { "type": "integer", "minimum": 1 },
				"requestTimeoutMs": { "type": "integer", "minimum": 1 },
				"maxRetries": { "type": "integer", "minimum": 0 },
				"loopMaxRepetitions": { "type": "integer", "minimum": 1 },
				"cleanupTimeoutMs": { "type": "integer", "minimum": 1 },
				"budgetTokens": { "type": "integer", "minimum": 1 }
			}
		},
		"evidence": {
			"type": "object",
			"additionalProperties": false,
			"required": ["retention", "redaction", "allowOpaque"],
			"properties": {
				"retention": { "enum": ["on", "retain-on-failure", "off"] },
				"redaction": { "enum": ["on", "off"] },
				"allowOpaque": { "type": "boolean" }
			}
		},
		"toolPolicy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["allowed"],
			"properties": {
				"allowed": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "type": "string", "minLength": 1 }
				}
			}
		},
		"policyDriver": {
			"type": "object",
			"additionalProperties": false,
			"required": ["settings", "tools"],
			"properties": {
				"settings": { "type": "object" },
				"tools": { "$ref": "#/$defs/toolPolicy" }
			}
		},
		"policy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["modelEgress", "bounds", "evidence", "drivers"],
			"properties": {
				"modelEgress": { "$ref": "#/$defs/modelEgress" },
				"bounds": { "$ref": "#/$defs/bounds" },
				"evidence": { "$ref": "#/$defs/evidence" },
				"drivers": {
					"type": "object",
					"minProperties": 1,
					"propertyNames": { "$ref": "#/$defs/id" },
					"additionalProperties": { "$ref": "#/$defs/policyDriver" }
				}
			}
		},
		"driverRegistration": {
			"type": "object",
			"additionalProperties": false,
			"required": ["package", "secrets"],
			"properties": {
				"package": { "type": "string", "minLength": 1 },
				"secrets": {
					"type": "object",
					"propertyNames": { "$ref": "#/$defs/id" },
					"additionalProperties": { "$ref": "#/$defs/id" }
				}
			}
		}
	}
}
